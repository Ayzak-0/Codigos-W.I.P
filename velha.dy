import random, os, sys, termios, tty
#==================================================#
def getch():
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(sys.stdin.fileno())
        ch = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    return ch
#==================================================#
def jogodavelha():
  p1 = p2 = p3 = p4 = p5 = p6 = p7 = p8 = p9 = "[ ]"
  ultimo = "[X]"
  vitorioso = "[ ]"
  x_win = 0
  o_win = 0
  empate = 0
  while True:
    os.system('clear')
    # Conferir Vitoria 1
    if p1 == p2 == p3 == "[O]" or p1 == p2 == p3 == "[X]":
      p1 = p2 = p3 = "[\u0335X\u0335]\u0335" if p1 == "[X]" else "[\u0335O\u0335]\u0335"
      vitorioso = "[X]" if p1 == "[\u0335X\u0335]\u0335" else "[O]"
      
    # Conferir Vitoria 2
    elif p4 == p5 == p6 == "[O]" or p4 == p5 == p6 == "[X]":
      p4 = p5 = p6 = "[\u0335X\u0335]\u0335" if p4 == "[X]" else "[\u0335O\u0335]\u0335"
      vitorioso = "[X]" if p4 == "[\u0335X\u0335]\u0335" else "[O]"
      
    # Conferir Vitoria 3

      p2 = p5 = p8 = "[\u0335X\u0335]\u0335" if p2 == "[X]" else "[\u0335O\u0335]\u0335"
      vitorioso = "[X]" if p2 == "[\u0335X\u0335]\u0335" else "[O]"
      
    # Conferir Vitoria 6
    elif p3 == p6 == p9 == "[O]" or p3 == p6 == p9 == "[X]":
      p3 = p6 = p9 = "[\u0335X\u0335]\u0335" if p3 == "[X]" else "[\u0335O\u0335]\u0335"
      vitorioso = "[X]" if p3 == "[\u0335X\u0335]\u0335" else "[O]"
      
    # Conferir Vitoria 7
    elif p1 == p5 == p9 == "[O]" or p1 == p5 == p9 == "[X]":
      p1 = p5 = p9 = "[\u0335X\u0335]\u0335" if p1 == "[X]" else "[\u0335O\u0335]\u0335"
      vitorioso = "[X]" if p1 == "[\u0335X\u0335]\u0335" else "[O]"
      
    # Conferir Vitoria 8
    elif p3 == p5 == p7 == "[O]" or p3 == p5 == p7 == "[X]":
      p3 = p5 = p7 = "[\u0335X\u0335]\u0335" if p3 == "[X]" else "[\u0335O\u0335]\u0335"
      vitorioso = "[X]" if p3 == "[\u0335X\u0335]\u0335" else "[O]"

    #Conferir Empate
    elif all(v != "[ ]" for v in (p1,p2,p3,p4,p5,p6,p7,p8,p9)):
      vitorioso = "[-]"
      
    if vitorioso != "[ ]":
      os.system('clear')
      print ("=" * 36)
      print(f'''[X] = {x_win}{" " * 6}{p7}{p8}{p9} |
[O] = {o_win}{" " * 6}{p4}{p5}{p6} |Vitoria: {vitorioso}
[-] = {empate}{" " * 6}{p1}{p2}{p3} |''')
      print ("=" * 36)
      print("\n", " " * 5, "Jogar Novamente? [Y/N]")
      while True:
        char = getch()
        if char in ["y", "n"]:
          if char == "y":
            if vitorioso == "[X]":
              x_win = x_win + 1
            elif vitorioso == "[O]":
              o_win = o_win + 1
            elif vitorioso == "[-]":
              empate = empate + 1
              
            p1 = p2 = p3 = p4 = p5 = p6 = p7 = p8 = p9 = "[ ]"
            ultimo = "[X]"
            vitorioso = "[ ]"
            break
          else:
            break
      if char == "n":
        break
    os.system('clear')
    print ("=" * 36)
    print(f'''[X] = {x_win}{" " * 6}{p7}{p8}{p9} |
[O] = {o_win}{" " * 6}{p4}{p5}{p6} |Vitoria: {vitorioso}
[-] = {empate}{" " * 6}{p1}{p2}{p3} |''')
    print ("=" * 36)
    print ('''[0/Esc] - Sair
[i] - Info (Como Jogar)
    
    ''')
    #

    
    char = getch()
    #
    if char == chr(27) or char == "0":
      break

    # #
    elif char == "1" and p1 == "[ ]" and vitorioso == "[ ]":
      p1 = "[X]" if ultimo == "[O]" else "[O]"
      ultimo = "[X]" if ultimo == "[O]" else "[O]"
    
    elif char == "2" and p2 == "[ ]" and vitorioso == "[ ]":
      p2 = "[X]" if ultimo == "[O]" else "[O]"
      ultimo = "[X]" if ultimo == "[O]" else "[O]"
    
    elif char == "3" and p3 == "[ ]" and vitorioso == "[ ]":
      p3 = "[X]" if ultimo == "[O]" else "[O]"
      ultimo = "[X]" if ultimo == "[O]" else "[O]"
    
    elif char == "4" and p4 == "[ ]" and vitorioso == "[ ]":
      p4 = "[X]" if ultimo == "[O]" else "[O]"
      ultimo = "[X]" if ultimo == "[O]" else "[O]"
    
    elif char == "5" and p5 == "[ ]" and vitorioso == "[ ]":
      p5 = "[X]" if ultimo == "[O]" else "[O]"
      ultimo = "[X]" if ultimo == "[O]" else "[O]"
    
    elif char == "6" and p6 == "[ ]" and vitorioso == "[ ]":
      p6 = "[X]" if ultimo == "[O]" else "[O]"
      ultimo = "[X]" if ultimo == "[O]" else "[O]"
    
    elif char == "7" and p7 == "[ ]" and vitorioso == "[ ]":
      p7 = "[X]" if ultimo == "[O]" else "[O]"
      ultimo = "[X]" if ultimo == "[O]" else "[O]"
    
    elif char == "8" and p8 == "[ ]" and vitorioso == "[ ]":
      p8 = "[X]" if ultimo == "[O]" else "[O]"
      ultimo = "[X]" if ultimo == "[O]" else "[O]"
    
    elif char == "9" and p9 == "[ ]" and vitorioso == "[ ]":
      p9 = "[X]" if ultimo == "[O]" else "[O]"
      ultimo = "[X]" if ultimo == "[O]" else "[O]"

    
    
    # #
      
# Jogar
while True:
  jogodavelha()
  break
  






  

      p1 = p4 = p7 = "[\u0335X\u0335]\u0335" if p1 == "[X]" else "[\u0335O\u0335]\u0335"
      vitorioso = "[X]" if p1 == "[\u0335X\u0335]\u0335" else "[O]"
      
    # Conferir Vitoria 5

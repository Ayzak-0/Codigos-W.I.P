      p7 = p8 = p9 = "[\u0335X\u0335]\u0335" if p7 == "[X]" else "[\u0335O\u0335]\u0335"
      vitorioso = "[X]" if p7 == "[\u0335X\u0335]\u0335" else "[O]"
      
    # Conferir Vitoria 4

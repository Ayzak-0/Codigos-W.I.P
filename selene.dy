import sys
import termios
import tty
import os
import random
# # # # # # # # # # # # # # # # # # # # # # # # #
def randomreq():
  zeanov = [0, 1, 2, 3, 4, 5, 6, 7, 9]
  num1 = str(random.choice(zeanov))
  num2 = str(random.choice(zeanov))
  num3 = str(random.choice(zeanov))
  num4 = str(random.choice(zeanov))
  num5 = str(random.choice(zeanov))
  num6 = str(random.choice(zeanov))
  req = int((num1 + num2 + num3 + num4 + num5 + num6))
  req = str(req)
  return req
# # # # # # # # # # # # # # # # # # # # # # # # #
def randomloc():
  locais = ["CD", "EXP"]
  local = random.choice(locais)
  return local
# # # # # # # # # # # # # # # # # # # # # # # # #
def randomusu():
  usuarios = ["cd.ezeq", "cd.levi", "cd.afog", "cd.serg", "cd.gust"]
  usuario = random.choice(usuarios)
  return usuario
# # # # # # # # # # # # # # # # # # # # # # # # #
def getch():
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(sys.stdin.fileno())
        ch = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    return ch
# # # # # # # # # # # # # # # # # # # # # # # # #
def sel0002():
  while True:
    os.system('clear')
    print("[01] SEL0002-MENU ENVIO/COLETA")
    print(31 * "-")
    print("\nOpções:\n")
    print('''1-Nova Requisicão
2-Coletar Req. Existente
3-Nova Req. Sem Reservar
4-Nova Req.P/Compl.Pedido 
5-Coletar Req. Picking
6-Abastecimento Picking
7-Abastecimento Especial
8-Consultar Minhas Requisicões
0-Voltar
    ''')
    print("Digite a opcao: [] ")
    print(31 * "-")
    while True:
      char = getch()
      if char == chr(27): #Backspace ou "0"
        break
      elif char == "0":
        break
      elif char == "1":
        break
      elif char == "2":
        break
      elif char == "3":
        break
      elif char == "4":
        break
      elif char == "5":
        break
      elif char == "6":
        break
      elif char == "7":
        sel0373()
        break
      elif char == "8":
        sel0008()
        break 
    if char == "0" or char == chr(27):
      break
# # # # # # # # # # # # # # # # # # # # # # #
def sel0373():
  req_mostrada = "       "
  local = "         "
  usuario = "       "
  while True:
    os.system('clear')
    print("[01]SEL0373-ABASTEC.ESPECIAL\n")
    print(f'''Num. Req:[{req_mostrada.ljust(7)}]Leit:[   ]
Loc/Usu:[{local.ljust(9)}][{usuario.ljust(7)}]
Setores:[                  ]
        [                  ]
        [                  ]
Obs:[  	                   ]
    [	 	           ]
p-Proxima req. da fila
1-Determinar setores
2-Sugestao de coleta
4-Devolver/Encerrar palete
6-Conferencia Requisicao
7-Abastecimento Picking
8-Etiqueta Volume
0-Voltar       Opcao:[]
    
    
    ''')
  
    char = getch() # <--- Char Getch para "pedir" Tecla
    
    # Esc ou "0" Para Sair
    if char == chr(27) or char == "0":
      break
    
    # Puxar "Proxima Req"
    elif char == "p" and local == "         ":               
      req_mostrada = randomreq()
    
    # "Pegar" A Req Para o Usuario
    elif char == chr(13) and req_mostrada != "       " and local == "         ":
      local = randomloc()
      usuario = randomusu()
      historico_req.append(req_mostrada)
      historico_loc.append(local)
      historico_usu.append(usuario)
      
    #Enter Para Digitar A Req # # # # # # # # # # # # #
    elif char == chr(13) and req_mostrada == "       ":
      lista_temporaria = []
      while True:
        char = getch()
        
        #Enter ou Esc Para Sair
        if char == chr(13) or char == chr(27):
          break
        
        #Registrar a Req. Digitada
        elif char in ["1","2","3","4","5","6","7","8","9","0"]:
          lista_temporaria.append(char)
          req = ("".join(lista_temporaria)) 
          req_mostrada = req

# # # # # # # # # # # # # # # # # # # # # # # #
def sel0008():
  
  while True:
    os.system('clear')
    titulo = "SEL0008-CONSULTA REQ."
    print(f"[01] {titulo: ^26}")
    print(31 * "=")
# cria 2 variaveis em cima do historico e um loop que mostra essas variaveis como numeração dos itens no historico.    
    for indice, item in enumerate(historico_req, start=1):
      print(f"[{str(indice).ljust(3)}] [{item.ljust(6)}] [{historico_loc[indice - 1].ljust(3)}] [{historico_usu[indice - 1]}]")
    
      
    char = getch()
    # Tecla 0 ou Esc Para Sair
    if char == "0" or char == chr(27):
      break
    # Enter Para Selecionar Req Da Lista
    if char == chr(13):
      lista_temporaria = []
      while True:
        char = getch()
        if char in ["1","2","3","4","5","6","7","8","9","0"]:
          lista_temporaria.append(char)
        elif char == chr(13):
          sel = "".join(lista_temporaria)
          sel = int(sel)
          print(historico_req[sel - 1])
          break
          
          
          








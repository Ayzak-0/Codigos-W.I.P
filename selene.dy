#''' Loop Principal e Menu de Saida '''#
historico_req = []
historico_loc = []
historico_usu = []
while True:
  sel0002()
  while True:
    os.system('clear')
    titulo = "Deseja Sair? [Y/N]"
    print("")
    print("")
    print("")
    print(f"{titulo: ^31}")
    print("")
    print("")
    print("")
    char = getch()
    if char == "y" or char == "n":
      break
    else:
      print("Selecione Uma Opção Valida! [Y/N]")
  if char == "y":
    break

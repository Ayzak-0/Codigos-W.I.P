#Problema "circulo":  Fazer um programa para ler o valor "r" do raio de um círculo, e depois mostrar o valor da área do círculo com três casas decimais. A fórmula da área do círculo é a seguinte: 𝑎𝑟𝑒𝑎 = 𝜋. 𝑟 . Você pode usar o valor de 𝜋 fornecido pela biblioteca da sua linguagem de programação, ou então, se preferir, use diretamente o valor 3.14159.
#==================================================#
import math
def picalc():
    while True:
        try:
            raio = float(input("Insira O Raio de um Circulo: "))
            if raio > 0:
                break
            else:
                print("Erro! Digite Um Raio Maior que 0")
        except ValueError:
                print("Erro! Digite Apenas Numeros!")
    area = math.pi * (raio ** 2)
    print(f"\nRaio: {raio}\nArea: {area}")
while True:
    picalc()
    while True:
        plagain = input("Continuar? [Y/N]: ").upper()
        if plagain == "N":
            break
        if plagain == "Y":
            break
        else:
            print("Selecione Uma Opção Valida")
    if plagain == "N":
        print("bye?")
        break
